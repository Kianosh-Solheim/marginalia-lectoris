<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/continue_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_continue_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/continue_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:text="CONTINUE READING"
            android:textColor="#111111"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/continue_filter_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_continue_tag_outline"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="FILTER: ALL"
            android:textColor="#111111"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Editorial Rule -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1.5dp"
        android:background="#111111"
        android:contentDescription="@null" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/continue_empty_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/continue_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="No active reading session"
            android:textColor="#111111"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/continue_empty_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_continue_tag_outline"
            android:fontFamily="monospace"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="OPEN LIBRARY →"
            android:textColor="#111111"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Content Container -->
    <LinearLayout
        android:id="@+id/continue_primary_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- 1. Featured Reading Section: Two most recently read items side-by-side -->
        <LinearLayout
            android:id="@+id/continue_featured_row"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.25"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Featured Item 1: Top row (Cover + Title/Author/Excerpt), Bottom row (Progress bar + % + time left) -->
            <LinearLayout
                android:id="@+id/continue_primary_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_continue_tag_outline"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Top Row: Cover positioned towards top + Title, Author, and Reading Excerpt beside it -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/continue_primary_cover"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="top"
                        android:layout_marginBottom="4dp"
                        android:adjustViewBounds="true"
                        android:background="@drawable/bg_continue_inner_box"
                        android:contentDescription="Primary Cover"
                        android:maxWidth="136dp"
                        android:padding="2dp"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="top"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/continue_primary_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="serif"
                            android:maxLines="2"
                            android:text="Featured Item 1"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/continue_primary_author"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="serif"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Author Name"
                            android:textColor="#333333"
                            android:textSize="11.5sp"
                            android:textStyle="italic" />

                        <TextView
                            android:id="@+id/continue_primary_snippet"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="5dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="serif"
                            android:lineSpacingMultiplier="1.15"
                            android:maxLines="4"
                            android:text="…Reading position excerpt or article abstract…"
                            android:textColor="#27272A"
                            android:textSize="11sp" />

                        <!-- Hidden compat views to preserve IDs -->
                        <TextView
                            android:id="@+id/continue_primary_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_continue_tag_outline"
                            android:textColor="#111111"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/continue_primary_locus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/continue_primary_cta"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom Row: Progress bar anchored at the bottom of the card with % and time left nearby -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/continue_primary_progress_img"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/continue_primary_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:text="46%"
                        android:textColor="#111111"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/continue_primary_time_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="42 min left"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/continue_secondary_divider"
                android:layout_width="10dp"
                android:layout_height="match_parent"
                android:contentDescription="@null" />

            <!-- Featured Item 2: Consistent layout with Top (Cover + Title/Author/Excerpt) and Bottom (Progress bar + % + time left) -->
            <LinearLayout
                android:id="@+id/continue_secondary_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_continue_tag_outline"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- Top Row: Cover positioned towards top + Title, Author, and Reading Excerpt beside it -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/continue_secondary_cover"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="top"
                        android:layout_marginBottom="4dp"
                        android:adjustViewBounds="true"
                        android:background="@drawable/bg_continue_inner_box"
                        android:contentDescription="Secondary Cover"
                        android:maxWidth="136dp"
                        android:padding="2dp"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="top"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/continue_secondary_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="serif"
                            android:maxLines="2"
                            android:text="Featured Item 2"
                            android:textColor="#111111"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/continue_secondary_author"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="serif"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:text="Author Name"
                            android:textColor="#333333"
                            android:textSize="11.5sp"
                            android:textStyle="italic" />

                        <TextView
                            android:id="@+id/continue_secondary_snippet"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="5dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="serif"
                            android:lineSpacingMultiplier="1.15"
                            android:maxLines="4"
                            android:text="…Reading position excerpt or article abstract…"
                            android:textColor="#27272A"
                            android:textSize="11sp" />

                        <!-- Hidden compat views to preserve IDs -->
                        <TextView
                            android:id="@+id/continue_secondary_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_continue_tag_outline"
                            android:textColor="#111111"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/continue_secondary_locus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/continue_secondary_cta"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom Row: Progress bar anchored at the bottom of the card with % and time left nearby -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/continue_secondary_progress_img"
                        android:layout_width="0dp"
                        android:layout_height="6dp"
                        android:layout_weight="1"
                        android:contentDescription="@null"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/continue_secondary_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="monospace"
                        android:text="54%"
                        android:textColor="#111111"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/continue_secondary_time_left"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:text="8 min left"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Row 1: RECENT BOOKS (Left-aligned cover shelf) -->
        <LinearLayout
            android:id="@+id/continue_shelf_books_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="0.95"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/continue_shelf_books_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:text="RECENT BOOKS"
                    android:textColor="#111111"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/continue_shelf_books_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_continue_tag_outline"
                    android:fontFamily="monospace"
                    android:paddingStart="7dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1dp"
                    android:text="‹"
                    android:textColor="#111111"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/continue_shelf_books_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_continue_tag_outline"
                    android:fontFamily="monospace"
                    android:paddingStart="7dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1dp"
                    android:text="›"
                    android:textColor="#111111"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/continue_shelf_books_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- 3. Row 2: RECENT ARTICLES (Left-aligned cover/thumbnail shelf) -->
        <LinearLayout
            android:id="@+id/continue_shelf_articles_section"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="0.95"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/continue_shelf_articles_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.06"
                    android:text="RECENT ARTICLES"
                    android:textColor="#111111"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/continue_shelf_articles_prev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_continue_tag_outline"
                    android:fontFamily="monospace"
                    android:paddingStart="7dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1dp"
                    android:text="‹"
                    android:textColor="#111111"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/continue_shelf_articles_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_continue_tag_outline"
                    android:fontFamily="monospace"
                    android:paddingStart="7dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="1dp"
                    android:text="›"
                    android:textColor="#111111"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/continue_shelf_articles_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:gravity="start|center_vertical"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Hidden legacy recents container -->
        <LinearLayout
            android:id="@+id/continue_recents_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/continue_recent_row_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/continue_recent_1" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/continue_recent_1_progress" android:layout_width="wrap_content" android:layout_height="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/continue_recent_row_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/continue_recent_2" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/continue_recent_2_progress" android:layout_width="wrap_content" android:layout_height="6dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/continue_recent_row_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/continue_recent_3" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ImageView android:id="@+id/continue_recent_3_progress" android:layout_width="wrap_content" android:layout_height="6dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

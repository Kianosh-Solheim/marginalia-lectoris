<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/continue_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_continue_widget"
    android:padding="8dp">

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/continue_empty_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/continue_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:gravity="center"
            android:text="Nothing in progress"
            android:textColor="#FF111111"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/continue_empty_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_continue_tag_outline"
            android:fontFamily="monospace"
            android:paddingLeft="10dp"
            android:paddingTop="4dp"
            android:paddingRight="10dp"
            android:paddingBottom="4dp"
            android:text="Open Library"
            android:textColor="#FF111111"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Primary content: Top (Cover + Title/Author/Excerpt) + Bottom (Progress bar + % + time left) -->
    <LinearLayout
        android:id="@+id/continue_primary_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/continue_primary_cover"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:layout_marginBottom="3dp"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_continue_inner_box"
                android:contentDescription="Cover"
                android:maxWidth="68dp"
                android:padding="1dp"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="top"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/continue_primary_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="serif"
                        android:maxLines="2"
                        android:text="Document Title"
                        android:textColor="#FF111111"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/continue_filter_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_continue_tag_outline"
                        android:fontFamily="monospace"
                        android:paddingLeft="5dp"
                        android:paddingTop="1dp"
                        android:paddingRight="5dp"
                        android:paddingBottom="1dp"
                        android:text="ALL"
                        android:textColor="#FF111111"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/continue_primary_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="Author Name"
                    android:textColor="#FF333333"
                    android:textSize="9.5sp"
                    android:textStyle="italic" />

                <TextView
                    android:id="@+id/continue_primary_snippet"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="2dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:maxLines="2"
                    android:text="…Reading position excerpt…"
                    android:textColor="#FF27272A"
                    android:textSize="8.5sp" />

                <!-- Hidden compat views -->
                <TextView
                    android:id="@+id/continue_primary_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_continue_tag_outline"
                    android:textColor="#FF111111"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/continue_primary_locus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom Progress Row anchored at bottom -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/continue_primary_progress_img"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_weight="1"
                android:contentDescription="Reading progress"
                android:scaleType="fitXY" />

            <TextView
                android:id="@+id/continue_primary_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="monospace"
                android:text="46%"
                android:textColor="#FF111111"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/continue_primary_time_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:singleLine="true"
                android:text="42 min left"
                android:textColor="#FF222222"
                android:textSize="8.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
